{
  "name": "CasoMora",
  "type": "object",
  "properties": {
    "certificado_id": {
      "type": "string"
    },
    "certificado_numero": {
      "type": "string"
    },
    "ifi_id": {
      "type": "string"
    },
    "ifi_nombre": {
      "type": "string"
    },
    "cliente_nombre": {
      "type": "string"
    },
    "cliente_cedula": {
      "type": "string"
    },
    "monto_credito": {
      "type": "number"
    },
    "porcentaje_cobertura": {
      "type": "number"
    },
    "monto_garantizado": {
      "type": "number"
    },
    "fecha_primer_incumplimiento": {
      "type": "string",
      "format": "date"
    },
    "dias_mora": {
      "type": "number"
    },
    "evidencia_gestion": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "reportado",
        "observado",
        "aprobado",
        "rechazado"
      ],
      "default": "reportado"
    },
    "motivo_decision": {
      "type": "string"
    },
    "fecha_decision": {
      "type": "string",
      "format": "date"
    },
    "decidido_por": {
      "type": "string"
    },
    "fecha_aprobacion": {
      "type": "string",
      "format": "date"
    },
    "fecha_limite_pago_siniestro": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "certificado_id",
    "ifi_id",
    "estado"
  ]
}